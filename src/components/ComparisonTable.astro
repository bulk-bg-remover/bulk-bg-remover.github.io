---
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = (ui[lang] || ui[defaultLang]).comparison;
---

<section id="comparison" class="py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto space-y-4 mb-16">
      <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#AF719D]/15 dark:bg-[#403D88]/50 text-[#403D88] dark:text-[#F8B2B2] border border-[#AF719D]/30 dark:border-[#8B639B]/40">
        {t.badge}
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t.title}
      </h2>
      <p class="text-base sm:text-lg text-slate-600 dark:text-slate-400">
        {t.subtitle}
      </p>
    </div>

    <!-- Comparison Table Card -->
    <div class="rounded-3xl border border-slate-200 dark:border-[#403D88]/40 bg-white dark:bg-[#151329] overflow-hidden shadow-sm">
      <div class="overflow-x-auto scrollbar-thin">
        <table class="w-full min-w-[540px] text-left border-collapse">
          <thead>
            <tr class="border-b border-slate-200 dark:border-[#403D88]/40 bg-slate-50 dark:bg-[#111024]">
              <th class="py-4 px-6 text-xs font-bold text-slate-500 dark:text-slate-400 uppercase tracking-wider w-1/3">
                {t.headers.feature}
              </th>
              <th class="py-4 px-6 text-xs font-bold text-[#8B639B] dark:text-[#F8B2B2] uppercase tracking-wider w-1/3 bg-[#AF719D]/10 dark:bg-[#403D88]/40">
                {t.headers.ourTool}
              </th>
              <th class="py-4 px-6 text-xs font-bold text-slate-400 uppercase tracking-wider w-1/3">
                {t.headers.cloudTools}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-[#403D88]/30 text-sm">
            {t.rows.map((row) => (
              <tr class="hover:bg-slate-50/50 dark:hover:bg-[#1a183b]/40 transition-colors">
                <td class="py-4 px-6 font-semibold text-slate-800 dark:text-slate-200">
                  {row.feature}
                </td>
                <td class="py-4 px-6 text-[#543862] dark:text-[#F8B2B2] font-semibold bg-[#AF719D]/5 dark:bg-[#403D88]/20">
                  <div class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-emerald-500 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                      <polyline points="20 6 9 17 4 12" />
                    </svg>
                    <span>{row.ourTool}</span>
                  </div>
                </td>
                <td class="py-4 px-6 text-slate-500 dark:text-slate-400">
                  <div class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-rose-400 mt-0.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="18" y1="6" x2="6" y2="18" />
                      <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                    <span>{row.cloudTools}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
