---
import { languages, type SupportedLanguage, defaultLang } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';

interface Props {
  currentLang: SupportedLanguage;
}

const { currentLang = defaultLang } = Astro.props;
const currentUrl = Astro.url.pathname;
const activeLangObj = languages[currentLang] || languages[defaultLang];
---

<div class="relative group">
  <button
    type="button"
    aria-label="Select Language"
    class="flex items-center gap-1.5 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-900/70 text-slate-700 dark:text-slate-300 text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 transition-all shadow-sm"
  >
    <span>{activeLangObj.flag}</span>
    <span>{activeLangObj.name}</span>
    <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div class="absolute right-0 mt-1.5 w-44 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 p-1.5 backdrop-blur-md">
    {Object.entries(languages).map(([langKey, langData]) => {
      const targetLang = langKey as SupportedLanguage;
      const targetHref = getLocalizedPath(currentUrl, targetLang);
      const isSelected = targetLang === currentLang;

      return (
        <a
          href={targetHref}
          hreflang={targetLang}
          lang={targetLang}
          class={`flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium transition-colors ${
            isSelected
              ? 'bg-[#AF719D]/15 dark:bg-[#403D88]/50 text-[#8B639B] dark:text-[#F8B2B2] font-bold'
              : 'text-slate-700 dark:text-slate-300 hover:bg-[#AF719D]/10 dark:hover:bg-[#403D88]/30'
          }`}
        >
          <div class="flex items-center gap-2">
            <span>{langData.flag}</span>
            <span>{langData.name}</span>
          </div>
          {isSelected && (
            <svg class="w-3.5 h-3.5 text-[#8B639B] dark:text-[#F8B2B2]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12" />
            </svg>
          )}
        </a>
      );
    })}
  </div>
</div>
