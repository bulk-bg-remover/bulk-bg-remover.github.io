---
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = (ui[lang] || ui[defaultLang]).howItWorks;
---

<section id="how-it-works" class="py-12 sm:py-16 lg:py-20 bg-slate-100/50 dark:bg-[#111024]/60 border-y border-slate-200/80 dark:border-[#403D88]/30">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-3xl mx-auto space-y-3 sm:space-y-4 mb-10 sm:mb-16">
      <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#8B639B]/15 dark:bg-[#403D88]/50 text-[#403D88] dark:text-[#F8B2B2] border border-[#8B639B]/30 dark:border-[#8B639B]/40">
        {t.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base lg:text-lg text-slate-600 dark:text-slate-400">
        {t.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {t.steps.map((step) => (
        <div class="relative p-5 sm:p-6 rounded-3xl border border-slate-200 dark:border-[#403D88]/40 bg-white dark:bg-[#151329] shadow-sm flex flex-col justify-between space-y-3 sm:space-y-4 hover:-translate-y-1 transition-transform duration-300">
          <div class="space-y-3">
            <span class="text-3xl font-black text-transparent bg-clip-text bg-gradient-to-r from-[#403D88] via-[#8B639B] to-[#AF719D] dark:from-[#F8B2B2] dark:to-[#AF719D] tracking-tighter">
              {step.number}
            </span>
            <h3 class="text-base font-bold text-slate-900 dark:text-white tracking-tight">
              {step.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
