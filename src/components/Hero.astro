---
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = (ui[lang] || ui[defaultLang]).hero;
---

<section class="relative pt-8 pb-8 sm:pt-14 sm:pb-12 overflow-hidden">
  <!-- Subtle Background Glows using Theme Palette -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[320px] sm:w-[650px] h-[220px] sm:h-[380px] bg-gradient-to-r from-[#403D88]/15 via-[#8B639B]/20 to-[#AF719D]/15 blur-[90px] sm:blur-[120px] rounded-full pointer-events-none -z-10" />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-4 sm:space-y-6">
    <!-- Top AI Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1 sm:px-4 sm:py-1.5 rounded-full text-xs sm:text-sm font-semibold bg-[#AF719D]/10 dark:bg-[#403D88]/40 text-[#403D88] dark:text-[#F8B2B2] border border-[#AF719D]/30 dark:border-[#8B639B]/50 shadow-xs animate-in fade-in slide-in-from-top-2 duration-500 max-w-full text-center">
      <span class="truncate">{t.badge}</span>
    </div>

    <!-- Main Hero Headline with Theme Gradient -->
    <h1 class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.2] sm:leading-[1.15]">
      {t.title}{' '}
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#403D88] via-[#8B639B] to-[#AF719D] dark:from-[#F8B2B2] dark:via-[#AF719D] dark:to-[#8B639B]">
        {t.titleHighlight}
      </span>
    </h1>

    <!-- Subtitle / Value Proposition -->
    <p class="text-sm sm:text-base lg:text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed">
      {t.description}
    </p>

    <!-- Key Guarantee Value Badges -->
    <div class="flex flex-wrap items-center justify-center gap-2.5 pt-2">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"/>
        </svg>
        {t.pillPrivacy}
      </span>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#8B639B]/10 dark:bg-[#403D88]/50 border border-[#8B639B]/30 dark:border-[#8B639B]/50 text-[#403D88] dark:text-[#F8B2B2]">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        {t.pillZeroUpload}
      </span>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800 text-amber-700 dark:text-amber-300">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
        </svg>
        {t.pillUnlimited}
      </span>

      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-[#AF719D]/10 dark:bg-[#AF719D]/20 border border-[#AF719D]/30 dark:border-[#AF719D]/40 text-[#543862] dark:text-[#F8B2B2]">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
        </svg>
        {t.pillWebgpu}
      </span>
    </div>
  </div>
</section>
