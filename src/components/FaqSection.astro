---
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = (ui[lang] || ui[defaultLang]).faq;
---

<section id="faq" class="py-12 sm:py-16 lg:py-20 bg-slate-100/50 dark:bg-[#111024]/60 border-t border-slate-200/80 dark:border-[#403D88]/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="text-center max-w-2xl mx-auto space-y-3 sm:space-y-4 mb-10 sm:mb-14">
      <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-[#AF719D]/15 dark:bg-[#403D88]/50 text-[#403D88] dark:text-[#F8B2B2] border border-[#AF719D]/30 dark:border-[#8B639B]/40">
        {t.badge}
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        {t.title}
      </h2>
      <p class="text-sm sm:text-base lg:text-lg text-slate-600 dark:text-slate-400">
        {t.subtitle}
      </p>
    </div>

    <!-- Accordion FAQ Items -->
    <div class="space-y-3 sm:space-y-4">
      {t.items.map((item) => (
        <details class="group rounded-2xl border border-slate-200 dark:border-[#403D88]/40 bg-white dark:bg-[#151329] p-4 sm:p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-200 open:shadow-lg open:shadow-[#403D88]/5 open:border-[#8B639B]/50">
          <summary class="flex cursor-pointer items-center justify-between gap-3 sm:gap-4 font-bold text-sm sm:text-base lg:text-lg text-slate-900 dark:text-slate-100 select-none group-hover:text-[#8B639B] dark:group-hover:text-[#F8B2B2] transition-colors">
            <span>{item.question}</span>
            <span class="shrink-0 transition-transform duration-300 group-open:-rotate-180 p-1.5 rounded-xl bg-[#AF719D]/15 dark:bg-[#403D88]/50 text-[#8B639B] dark:text-[#F8B2B2]">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-slate-100 dark:border-[#403D88]/30 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed">
            <p>{item.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
