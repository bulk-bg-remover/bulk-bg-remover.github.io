---
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';
import { getLocalizedPath } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';
import ThemeToggle from './ThemeToggle.jsx';

interface Props {
  lang: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = ui[lang] || ui[defaultLang];
const homeUrl = lang === defaultLang ? '/' : `/${lang}/`;
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-white/85 dark:bg-[#0f0e1d]/85 border-b border-slate-200/80 dark:border-[#403D88]/40 transition-colors">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#403D88] via-[#8B639B] to-[#AF719D] flex items-center justify-center text-white shadow-md shadow-[#403D88]/25 group-hover:scale-105 transition-transform">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
          <circle cx="9" cy="9" r="2"/>
          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
        </svg>
      </div>
      <span class="font-bold text-base sm:text-lg text-slate-900 dark:text-white tracking-tight">
        {t.nav.brandName}
      </span>
    </a>

    <!-- Desktop Navigation Anchors (Hidden on Mobile & Tablet, Visible on Large Desktop) -->
    <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-600 dark:text-slate-300">
      <a href="#features" class="hover:text-[#8B639B] dark:hover:text-[#F8B2B2] transition-colors">
        {t.nav.features}
      </a>
      <a href="#how-it-works" class="hover:text-[#8B639B] dark:hover:text-[#F8B2B2] transition-colors">
        {t.nav.howItWorks}
      </a>
      <a href="#comparison" class="hover:text-[#8B639B] dark:hover:text-[#F8B2B2] transition-colors">
        {t.nav.comparison}
      </a>
      <a href="#faq" class="hover:text-[#8B639B] dark:hover:text-[#F8B2B2] transition-colors">
        {t.nav.faq}
      </a>
    </nav>

    <!-- Controls: Language Picker + Theme Toggle + Support Button -->
    <div class="flex items-center gap-2 sm:gap-2.5">
      <LanguagePicker currentLang={lang} />
      <ThemeToggle client:load />

      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.nav.supportDev}
        title={t.nav.supportDev}
        class="inline-flex items-center gap-1.5 p-2 lg:px-3 lg:py-1.5 rounded-xl bg-[#AF719D]/15 hover:bg-[#AF719D]/25 text-[#543862] dark:text-[#F8B2B2] border border-[#AF719D]/40 dark:border-[#8B639B]/50 font-semibold text-xs transition-all hover:scale-105 active:scale-95 shadow-xs"
      >
        <svg class="w-5 h-5 lg:w-4 lg:h-4 text-[#8B639B] dark:text-[#F8B2B2] fill-[#F8B2B2]/40 flex-shrink-0" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10 2v2M14 2v2M6 2v2M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/>
          <line x1="6" y1="1" x2="6" y2="4"/>
          <line x1="10" y1="1" x2="10" y2="4"/>
          <line x1="14" y1="1" x2="14" y2="4"/>
        </svg>
        <span class="hidden lg:inline whitespace-nowrap">{t.nav.supportDev}</span>
      </a>
    </div>
  </div>
</header>
