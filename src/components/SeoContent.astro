---
import { ui, defaultLang, type SupportedLanguage } from '../i18n/ui';

interface Props {
  lang: SupportedLanguage;
}

const { lang = defaultLang } = Astro.props;
const t = (ui[lang] || ui[defaultLang]).seoContent;
---

<section class="py-20 border-t border-slate-200 dark:border-[#403D88]/30">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="prose prose-slate dark:prose-invert max-w-none space-y-6">
      <div class="space-y-2 border-b border-slate-200 dark:border-[#403D88]/30 pb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight not-prose">
          {t.title}
        </h2>
        <p class="text-base text-slate-600 dark:text-slate-400 not-prose">
          {t.subtitle}
        </p>
      </div>

      <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
        {t.p1}
      </p>

      <p class="text-slate-700 dark:text-slate-300 leading-relaxed">
        {t.p2}
      </p>

      <div class="p-6 rounded-3xl bg-gradient-to-br from-[#AF719D]/10 via-[#8B639B]/10 to-[#403D88]/20 dark:from-[#403D88]/40 dark:via-[#1a183b] dark:to-[#0f0e1d] border border-[#8B639B]/30 not-prose space-y-3 shadow-xs">
        <h3 class="text-lg font-bold text-[#403D88] dark:text-[#F8B2B2]">
          {t.p3Title}
        </h3>
        <p class="text-sm text-[#543862] dark:text-slate-300 leading-relaxed">
          {t.p3}
        </p>
      </div>
    </div>
  </div>
</section>
