---
import '../styles/global.css';
import { ui, languages, type SupportedLanguage, defaultLang } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: SupportedLanguage;
  title?: string;
  description?: string;
}

const { lang = defaultLang, title, description } = Astro.props;
const t = ui[lang] || ui[defaultLang];

const pageTitle = title || t.meta.title;
const pageDescription = description || t.meta.description;
const siteUrl = 'https://bulk-bg-remover.github.io';
const canonicalUrl = lang === defaultLang ? `${siteUrl}/` : `${siteUrl}/${lang}/`;
const ogImageUrl = 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';

// Bidirectional hreflang links
const hreflangs = [
  { lang: 'en', href: `${siteUrl}/` },
  { lang: 'es', href: `${siteUrl}/es/` },
  { lang: 'pt', href: `${siteUrl}/pt/` },
  { lang: 'de', href: `${siteUrl}/de/` },
  { lang: 'fr', href: `${siteUrl}/fr/` },
  { lang: 'ja', href: `${siteUrl}/ja/` },
  { lang: 'x-default', href: `${siteUrl}/` },
];

// Build Breadcrumb Hierarchy
const breadcrumbItems = [
  {
    '@type': 'ListItem',
    'position': 1,
    'name': 'Home',
    'item': `${siteUrl}/`,
  },
];

if (lang !== defaultLang) {
  breadcrumbItems.push({
    '@type': 'ListItem',
    'position': 2,
    'name': languages[lang]?.name || lang.toUpperCase(),
    'item': canonicalUrl,
  });
}

// Enterprise Schema.org Structured Data Graph
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': `${siteUrl}/`,
      'name': 'Bulk BG Remover',
      'description': t.meta.description,
      'inLanguage': lang,
      'publisher': {
        '@id': `${siteUrl}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      'name': 'Bulk BG Remover',
      'url': `${siteUrl}/`,
      'logo': {
        '@type': 'ImageObject',
        'url': ogImageUrl,
        'width': 1200,
        'height': 630,
      },
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      'name': t.nav.brandName,
      'url': canonicalUrl,
      'applicationCategory': 'MultimediaApplication',
      'operatingSystem': 'All (Web Browser, Chrome, Firefox, Safari, Edge)',
      'image': ogImageUrl,
      'screenshot': ogImageUrl,
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD',
        'availability': 'https://schema.org/InStock',
      },
      'featureList': [
        'Client-side high-precision neural AI inference',
        'WebGPU hardware acceleration with WASM fallback',
        'Multi-file batch processing (50+ images simultaneously)',
        'Custom solid and transparent background replacement',
        'Instant ZIP archive export',
        '100% private zero-server uploads',
      ],
      'browserRequirements': 'Requires WebGPU or WebAssembly capable modern browser',
      'description': pageDescription,
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}#breadcrumbs`,
      'itemListElement': breadcrumbItems,
    },
    {
      '@type': 'HowTo',
      '@id': `${canonicalUrl}#howto`,
      'name': t.howItWorks.title,
      'description': t.howItWorks.subtitle,
      'image': ogImageUrl,
      'totalTime': 'PT10S',
      'step': t.howItWorks.steps.map((step, index) => ({
        '@type': 'HowToStep',
        'position': index + 1,
        'name': step.title,
        'text': step.description,
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      'mainEntity': t.faq.items.map((item) => ({
        '@type': 'Question',
        'name': item.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': item.answer,
        },
      })),
    },
  ],
};
---

<!doctype html>
<html lang={lang} dir="ltr" class="scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-MQPXCXKXCG"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-MQPXCXKXCG');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Resource Hints & DNS Prefetching -->
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />
    <link rel="preconnect" href="https://staticimgly.com" crossorigin />
    <link rel="dns-prefetch" href="https://staticimgly.com" />

    <!-- Primary Search Engine Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={t.meta.keywords} />
    <meta name="author" content="Bulk BG Remover" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Mobile Browser Theme Color -->
    <meta name="theme-color" content="#403D88" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f0e1d" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={t.nav.brandName} />
    <meta name="application-name" content={t.nav.brandName} />
    <meta name="format-detection" content="telephone=no" />

    <!-- 7 Bidirectional hreflang Tags (International SEO) -->
    {hreflangs.map((item) => (
      <link rel="alternate" hreflang={item.lang} href={item.href} />
    ))}

    <!-- Open Graph Protocol (Facebook, LinkedIn, Discord, WhatsApp) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={t.meta.ogTitle} />
    <meta property="og:description" content={t.meta.ogDescription} />
    <meta property="og:site_name" content={t.nav.brandName} />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />

    <!-- Twitter Cards Protocol (X / Twitter) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={t.meta.ogTitle} />
    <meta name="twitter:description" content={t.meta.ogDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={pageTitle} />

    <!-- Synchronous anti-FOUC script for dark/light mode -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var supportDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (stored === 'dark' || (!stored && supportDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Schema.org JSON-LD Structured Data Graph -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="bg-slate-50 dark:bg-[#0f0e1d] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans selection:bg-[#AF719D] selection:text-white transition-colors duration-200 overflow-x-hidden">
    <Header lang={lang} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
